# Hitung Sehat — Environment Variables Configuration
# Salin file ini menjadi .env untuk menjalankan dengan Supabase asli

# 1. Supabase Project URL (Dapat dilihat di dashboard supabase -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (Dapat dilihat di dashboard supabase -> Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
